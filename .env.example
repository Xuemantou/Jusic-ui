# 复制为 .env.local 即可生效（Vite 环境变量需 VITE_ 前缀）

# ---- 后端地址 ----
# 留空则按环境取默认值：开发/测试 = http://127.0.0.1:8080，生产 = 同源（空字符串）
# 后端直跑（未走 docker 端口映射）时应改为 http://127.0.0.1:8888
VITE_API_BASE=

# ---- 首页背景 ----
# 背景图 URL；留空则使用内置 src/assets/images/background.jpg
# 想换背景有三种方式（优先级从高到低）：
#   1. 运行时：localStorage['JUSIC_BG_IMAGE']（预留设置界面）
#   2. 构建时：设置下面的 VITE_BG_IMAGE
#   3. 直接替换 src/assets/images/background.jpg 文件
VITE_BG_IMAGE=

# 首页背景遮罩透明度 0~1（越大背景越暗、前景文字越清晰）
VITE_BG_MASK=0.55

# ---- 播放页动态背景（当前专辑封面模糊） ----
# 设为 false 可关闭，改为纯色背景
VITE_BG_ALBUM_BLUR=true

# 专辑模糊背景透明度 0~1
VITE_BG_ALBUM_OPACITY=0.35
